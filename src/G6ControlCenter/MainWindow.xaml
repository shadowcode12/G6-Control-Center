<Window x:Class="G6ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G6 Control Center" Height="780" Width="1280"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101720" BorderBrush="#253140" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,26,18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,38">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="G6" Foreground="#101710" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="G6 CONTROL" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="CENTER" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,12" />
                    <Border Background="#26351E" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="{StaticResource AccentBrush}" FontSize="17" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="◷   Monitoring" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="12,10" />
                    <TextBlock Text="◈   Performance" Foreground="#647386" FontSize="13" Margin="12,10" />
                    <TextBlock Text="▤   Battery" Foreground="#647386" FontSize="13" Margin="12,10" />
                    <TextBlock Text="⌁   GPU" Foreground="#647386" FontSize="13" Margin="12,10" />
                    <TextBlock Text="⌨   Keyboard" Foreground="#647386" FontSize="13" Margin="12,10" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="13" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DEVELOPMENT BUILD" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="v0.1.2 · Foundation" FontSize="12" Margin="0,7,0,0" />
                            <TextBlock Text="Hardware writes disabled" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="G6 Control Center is an independent project." TextWrapping="Wrap" Foreground="#667589" FontSize="10" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,32,38,34">
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="SYSTEM OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Your machine, at a glance." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="A lightweight foundation for a laptop-first control center." FontSize="13" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#202B37" CornerRadius="18" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="LIVE TELEMETRY" FontSize="10" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="01" DockPanel.Dock="Right" FontSize="10" Foreground="#627185" />
                            </DockPanel>
                            <TextBlock Text="{Binding CpuValue}" FontSize="38" FontWeight="SemiBold" Margin="0,18,0,14" />
                            <ProgressBar Style="{StaticResource MetricProgress}" Maximum="100" Value="{Binding CpuUsage}" />
                            <TextBlock Text="Total processor utilization" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="MEMORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="02" DockPanel.Dock="Right" FontSize="10" Foreground="#627185" />
                            </DockPanel>
                            <TextBlock Text="{Binding MemoryValue}" FontSize="38" FontWeight="SemiBold" Margin="0,18,0,14" />
                            <ProgressBar Style="{StaticResource MetricProgress}" Maximum="100" Value="{Binding MemoryUsage}" />
                            <TextBlock Text="{Binding MemoryDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="SYSTEM DRIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="03" DockPanel.Dock="Right" FontSize="10" Foreground="#627185" />
                            </DockPanel>
                            <TextBlock Text="{Binding DriveValue}" FontSize="38" FontWeight="SemiBold" Margin="0,18,0,14" />
                            <ProgressBar Style="{StaticResource MetricProgress}" Maximum="100" Value="{Binding DriveUsage}" />
                            <TextBlock Text="{Binding DriveDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="SYSTEM UPTIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="04" DockPanel.Dock="Right" FontSize="10" Foreground="#627185" />
                            </DockPanel>
                            <TextBlock Text="{Binding UptimeValue}" FontSize="31" FontWeight="SemiBold" Margin="0,23,0,22" />
                            <TextBlock Text="Time since the last Windows boot" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="22" Margin="0,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="HARDWARE CONTROL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Controls are being mapped to your exact G6 hardware." FontSize="15" FontWeight="SemiBold" Margin="0,8,0,5" />
                            <TextBlock Text="Fan, thermal, EC and power-profile writes remain disabled until the device interface is verified." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="650" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#27351F" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="SAFE MODE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <DockPanel Margin="0,18,16,0">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
